.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / process files
pids/
*.pid
*.seed
*.pid.lock

# Test and coverage output
coverage/
.nyc_output/

# Build output
dist/
build/
.cache/

# Uploaded files (product images, receipts) if you store them locally
uploads/

