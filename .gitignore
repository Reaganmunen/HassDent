*.sql.bak
*.dump
*.backup

# Editor and IDE settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Vercel / deployment
.vercel/

# Temporary files
tmp/
temp/
*.tmp